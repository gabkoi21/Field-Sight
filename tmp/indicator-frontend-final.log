            <span
              class="font-medium"
            >
              Indicator name
            </span>
            <input
              class="min-h-11 w-full min-w-0 rounded-lg border border-[var(--fs-control-border)] bg-[var(--fs-surface)] px-3 py-2 text-base sm:text-sm text-[var(--fs-text)] transition-colors hover:border-[var(--fs-muted)] focus:border-[var(--fs-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--fs-primary)] focus:ring-offset-1 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:opacity-60"
              maxlength="200"
              minlength="2"
              required=""
              value="Draft indicator"
            />
          </label>
          <label
            class="grid min-w-0 gap-1.5 text-xs text-[#526d75]"
          >
            <span
              class="font-medium"
            >
              Indicator format
            </span>
            <select
              class="min-h-11 w-full min-w-0 rounded-lg border border-[var(--fs-control-border)] bg-[var(--fs-surface)] px-3 py-2 text-base sm:text-sm text-[var(--fs-text)] transition-colors hover:border-[var(--fs-muted)] focus:border-[var(--fs-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--fs-primary)] focus:ring-offset-1 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:opacity-60"
              required=""
