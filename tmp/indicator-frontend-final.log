        class="w-full max-h-[90vh] max-w-[680px] p-6 overflow-y-auto rounded-lg bg-white shadow-xl"
      >
        <header
          class="mb-5 flex items-start justify-between gap-3 border-b border-[#e7edef] pb-4 "
        >
          <div>
            <h2
              class="m-0 text-lg font-semibold text-[#24434c]"
            >
              Add indicator
            </h2>
            <p
              class="mb-0 mt-1 text-xs leading-5 text-[#73868d]"
            >
              Start with a name and format. Add targets, baselines and source data later by opening the indicator.
            </p>
          </div>
          <button
            aria-label="Close dialog"
            class="border-0 bg-transparent p-1 text-[#73868d]"
            type="button"
          >
            <svg
              class="lucide lucide-x"
              fill="none"
              height="18"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="18"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18 6 6 18"
              />
              <path
                d="m6 6 12 12"
              />
            </svg>
          </button>
        </header>
        <form
          class="grid gap-4"
        >
          <label
            class="grid min-w-0 gap-1.5 text-xs text-[#526d75]"
